<div id="iwb-promo" style="height: 9.375em; margin: 0.5em 10px 2px 8px; padding: 0; background-color: #232324; outline: 2px black solid; border: 2px #313233 solid;">
    <a style="height: 100%; width: 7.5em; display: block; background-image: url('https://uk.minecraft.wiki/images/Indie_Wiki_Buddy_sidebar.png?a57fe'); background-size: cover; margin: auto;" href="https://uk.minecraft.wiki/w/Minecraft_Wiki:Indie_Wiki_Buddy">
        <button id="iwb-promo-close" style="position: absolute; right: 12px; background: transparent; border: 0; color: #8c8c8c; font-size: .75em; cursor: pointer; border-radius: 5px 0 0 5px;" title="Hide">X</button>
    </a>
</div>
<script>
        document.getElementById('iwb-promo-close').addEventListener('click', (e) => {
            e.preventDefault();
            const cookieExpiry = new Date();
            cookieExpiry.setFullYear(cookieExpiry.getFullYear() + 1);

            document.getElementById('iwb-promo').remove();
            document.cookie = 'iwb_promo=1; path=/; expires=' + cookieExpiry.toString();

        })
</script>
