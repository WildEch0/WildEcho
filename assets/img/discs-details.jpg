D1%83%D0%B3" class="mw-redirect" title="Луг">лугу</a>.</td></tr></tbody></table></div>
<div class="mw-heading mw-heading3"><h3 id="Bedrock_Edition"><i>Bedrock Edition</i></h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/%D0%9F%D0%BB%D0%B0%D1%82%D1%96%D0%B2%D0%BA%D0%B0?section=12&amp;veaction=edit" title="Редагувати розділ: Bedrock Edition" class="mw-editsection-visualeditor"><span>ред.</span></a><span class="mw-editsection-divider"> | </span><a href="/w/%D0%9F%D0%BB%D0%B0%D1%82%D1%96%D0%B2%D0%BA%D0%B0?action=edit&amp;section=12" title="Редагувати вихідний код розділу: Bedrock Edition"><span>ред. код</span></a><span class="mw-editsection-bracket">]</span></span></div>
<div style="overflow: auto;"><table class="wikitable collapsible sortable" style="text-align:center"><tbody><tr><th class="unsortable" colspan="8"></th></tr><tr><th colspan="2" class="unsortable">Значок</th><th rowspan="2" class="sortable">Досягнення</th><th rowspan="2" class="unsortable">Опис у грі</th><th rowspan="2" class="unsortable">Завдання (якщо відрізняються)</th><th rowspan="2" class="sortable">Очки гравця зароблено</th><th rowspan="2" class="sortable">Тип трофея (<span class="explain" title="PlayStation">PS</span>)</th></tr><tr><th class="unsortable">PS4</th><th class="unsortable">Інші</th></tr><tr id="Звук&#95;музики" style="text-align:left"><td style="text-align:center"><span class="sprite-file" style="height:47px;width:47px;--vertical-align:middle"><span class="pixel-image" typeof="mw:File"><a href="/w/%D0%94%D0%BE%D1%81%D1%8F%D0%B3%D0%BD%D0%B5%D0%BD%D0%BD%D1%8F_(Bedrock_Edition)#Звук_музики" title="Досягнення (Bedrock Edition)"><img alt="AchievementSprite sound-of-music.png: зображення спрайту в Minecraft для sound of music, що посилається на Досягнення (Bedrock Edition)#Звук музики" src="https://minecraft.wiki/images/thumb/AchievementSprite_sound-of-music.png/47px-AchievementSprite_sound-of-music.png?24730" decoding="async" loading="lazy" width="47" height="47" class="mw-file-element" srcset="https://minecraft.wiki/images/AchievementSprite_sound-of-music.png?24730 2x" data-file-width="48" data-file-height="48" /></a></span></span></td><td style="text-align:center"><span class="sprite-file" style="height:48px;width:84px;--vertical-align:middle"><span class="pixel-image" typeof="mw:File"><a href="/w/%D0%94%D0%BE%D1%81%D1%8F%D0%B3%D0%BD%D0%B5%D0%BD%D0%BD%D1%8F_(Bedrock_Edition)#Звук_музики" title="Досягнення (Bedrock Edition)"><img alt="NewAchievementSprite sound-of-music.png: зображення спрайту в Minecraft для sound of music, що посилається на Досягнення (Bedrock Edition)#Звук музики" src="https://minecraft.wiki/images/NewAchievementSprite_sound-of-music.png?2ec9a" decoding="async" loading="lazy" width="84" height="48" class="mw-file-element" data-file-width="84" data-file-height="48" /></a></span></span></td><td><a href="/w/%D0%94%D0%BE%D1%81%D1%8F%D0%B3%D0%BD%D0%B5%D0%BD%D0%BD%D1%8F_(Bedrock_Edition)#Звук_музики" title="Досягнення (Bedrock Edition)">Звук музики</a></td><td>Оживити <a href="/w/%D0%9B%D1%83%D0%BA%D0%B0" title="Лука">луки</a> звуками музики з музичного автомата.</td><td><span class="explain" title="Усталено клацання правою кнопкою миші або лівим тригером контролера.">Використайте</span> <a class="mw-selflink selflink">музичний диск</a> на програвачі в біомі лук.</td><td>10</td><td>Бронза</td></tr></tbody></table></div>
<div class="mw-heading mw-heading2"><h2 id="Історія"><span id=".D0.86.D1.81.D1.82.D0.BE.D1.80.D1.96.D1.8F"></span>Історія</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/%D0%9F%D0%BB%D0%B0%D1%82%D1%96%D0%B2%D0%BA%D0%B0?section=13&amp;veaction=edit" title="Редагувати розділ: Історія" class="mw-editsection-visualeditor"><span>ред.</span></a><span class="mw-editsection-divider"> | </span><a href="/w/%D0%9F%D0%BB%D0%B0%D1%82%D1%96%D0%B2%D0%BA%D0%B0?action=edit&amp;section=13" title="Редагувати вихідний код розділу: Історія"><span>ред. код</span></a><span class="mw-editsection-bracket">]</span></span></div>
<style data-mw-deduplicate="TemplateStyles:r145823">@media screen and (max-width:1119px){.mw-parser-output th.vertical-header{min-width:1em}.mw-parser-output th.vertical-header>*{writing-mode:vertical-lr;transform:scale(-1);vertical-align:middle;line-height:1em}.mw-parser-output th.vertical-header div{display:inline-block;border:none;padding:0;margin:0}.mw-parser-output .historytable-experiment{margin:1em -4px 0.5em -4px}.mw-parser-output table[data-description="Історія"] th{line-height:1.2em}.mw-parser-output table[data-description="Історія"] th.nowrap{white-space:normal}.mw-parser-output table[data-description="Історія"] th:not(.historytable-subheader),.mw-parser-output .historytable-experiment+span{font-size:smaller}}</style><table class="wikitable pixel-image" data-description="Історія"><tbody><tr class="collapsible collapsible-rows"><th class="historytable-subheader" colspan="8" style="border-bottom: none"><a href="/w/Alpha_(Java_Edition)" title="Alpha (Java Edition)">Java Edition Alpha</a></th></tr><tr><th rowspan="1" colspan="7"><a target="_blank" rel="nofollow noreferrer noopener" class="external text" href="https://youtube.com/watch?v=3Sthf0u94Cs">Квітень 2010 року</a></th><td><a href="/w/%D0%94%D0%B0%D0%BD%D1%96%D0%B5%D0%BB%D1%8C_%D0%A0%D0%BE%D0%B7%D0%B5%D0%BD%D1%84%D0%B5%D0%BB%D1%8C%D0%B4" title="Даніель Розенфельд">C418</a> завантажив відео на <a href="https://uk.wikipedia.org/wiki/YouTube" class="extiw" title="wikipedia:YouTube">YouTube</a>, яке містить попередній перегляди багатьох музичних треків, які пізніше були додані як платівки. (Це відео більше не доступне.)</td></tr><tr><th class="nowrap" rowspan="3" colspan="7"><a href="/w/Alpha_v1.0.14_(Java_Edition)" title="Alpha v1.0.14 (Java Edition)">v1.0.14</a></th><td><span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_13_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_13_JE1_BE1.png/32px-Music_Disc_13_JE1_BE1.png?3ad74" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_13_JE1_BE1.png/64px-Music_Disc_13_JE1_BE1.png?3ad74 2x" data-file-width="160" data-file-height="160" /></a></span> «13» і <span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_cat_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_cat_JE1_BE1.png/32px-Music_Disc_cat_JE1_BE1.png?611e5" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_cat_JE1_BE1.png/64px-Music_Disc_cat_JE1_BE1.png?611e5 2x" data-file-width="160" data-file-height="160" /></a></span> «cat» є першими платівками, які було додано в <i>Minecraft</i>.</td></tr><tr><td>Платівки були додані до скриней в <a href="/w/%D0%A1%D0%BA%D0%B0%D1%80%D0%B1%D0%BD%D0%B8%D1%86%D1%8F" title="Скарбниця">скарбницях</a>.</td></tr><tr><td>Також платівки можуть <a href="/w/%D0%94%D1%80%D0%BE%D0%BF" title="Дроп">випасти</a> із <a href="/w/%D0%9A%D1%80%D1%96%D0%BF%D0%B5%D1%80" title="Кріпер">кріпера</a> вбитого <a href="/w/%D0%A1%D0%BA%D0%B5%D0%BB%D0%B5%D1%82" title="Скелет">скелетом</a>.</td></tr><tr><th class="nowrap" rowspan="1" colspan="7"><a href="/w/%D0%9A%D0%B0%D1%82%D0%B5%D0%B3%D0%BE%D1%80%D1%96%D1%8F:%D0%9D%D0%B5%D0%B2%D1%96%D0%B4%D0%BE%D0%BC%D0%B0_%D1%96%D1%81%D1%82%D0%BE%D1%80%D1%96%D1%8F_%D0%B2%D0%B5%D1%80%D1%81%D1%96%D1%97" title="Категорія:Невідома історія версії">?</a></th><td>В код гри додали посилання на 10 нових музичних треків.  Усі вони були закодовані у  .mus форматі.</td></tr><tr class="collapsible collapsible-rows"><th class="historytable-subheader" colspan="8" style="border-bottom: none"><a href="/w/Beta_(Java_Edition)" title="Beta (Java Edition)">Java Edition Beta</a></th></tr><tr><th class="nowrap" rowspan="1" colspan="7"><a href="/w/Beta_1.2_02_(Java_Edition)" title="Beta 1.2 02 (Java Edition)">1.2_02</a></th><td>До цього оновлення золоті платівки «13» були помітно частішими, аніж зелені «cat». Тепер зелена плавка «cat» <a href="/w/%D0%94%D1%80%D0%BE%D0%BF" title="Дроп">випадає</a> частіше.</td></tr><tr><th rowspan="1" colspan="7"><a target="_blank" rel="nofollow noreferrer noopener" class="external text" href="https://web.archive.org/web/20190710082844/https://twitter.com/C418/status/98174571756265473">1 серпня 2011 року</a></th><td>C418 анонсує нові платівки.</td></tr><tr class="collapsible collapsible-rows"><th class="historytable-subheader" colspan="8" style="border-bottom: none"><a href="/w/%D0%86%D1%81%D1%82%D0%BE%D1%80%D1%96%D1%8F_%D0%B2%D0%B5%D1%80%D1%81%D1%96%D0%B9_(Java_Edition)" title="Історія версій (Java Edition)"><i>Java Edition</i></a></th></tr><tr><th class="nowrap" rowspan="1" colspan="3"><a href="/w/1.0.0_(Java_Edition)" title="1.0.0 (Java Edition)">1.0.0</a></th><th colspan="4" rowspan="1"><a href="/w/Beta_1.9_Prerelease_2_(Java_Edition)" title="Beta 1.9 Prerelease 2 (Java Edition)">Beta 1.9 Prerelease 2</a></th><td><span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_11_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_11_JE1_BE1.png/32px-Music_Disc_11_JE1_BE1.png?b1d4c" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_11_JE1_BE1.png/64px-Music_Disc_11_JE1_BE1.png?b1d4c 2x" data-file-width="160" data-file-height="160" /></a></span> <span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_blocks_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_blocks_JE1_BE1.png/32px-Music_Disc_blocks_JE1_BE1.png?86de0" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_blocks_JE1_BE1.png/64px-Music_Disc_blocks_JE1_BE1.png?86de0 2x" data-file-width="160" data-file-height="160" /></a></span> <span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_chirp_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_chirp_JE1_BE1.png/32px-Music_Disc_chirp_JE1_BE1.png?aea36" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_chirp_JE1_BE1.png/64px-Music_Disc_chirp_JE1_BE1.png?aea36 2x" data-file-width="160" data-file-height="160" /></a></span> <span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_far_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_far_JE1_BE1.png/32px-Music_Disc_far_JE1_BE1.png?3c3b2" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_far_JE1_BE1.png/64px-Music_Disc_far_JE1_BE1.png?3c3b2 2x" data-file-width="160" data-file-height="160" /></a></span> <span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_mall_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_mall_JE1_BE1.png/32px-Music_Disc_mall_JE1_BE1.png?044bb" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_mall_JE1_BE1.png/64px-Music_Disc_mall_JE1_BE1.png?044bb 2x" data-file-width="160" data-file-height="160" /></a></span> <span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_mellohi_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_mellohi_JE1_BE1.png/32px-Music_Disc_mellohi_JE1_BE1.png?0a62d" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_mellohi_JE1_BE1.png/64px-Music_Disc_mellohi_JE1_BE1.png?0a62d 2x" data-file-width="160" data-file-height="160" /></a></span> <span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_stal_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_stal_JE1_BE1.png/32px-Music_Disc_stal_JE1_BE1.png?14e21" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_stal_JE1_BE1.png/64px-Music_Disc_stal_JE1_BE1.png?14e21 2x" data-file-width="160" data-file-height="160" /></a></span> <span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_strad_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_strad_JE1_BE1.png/32px-Music_Disc_strad_JE1_BE1.png?8fa76" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_strad_JE1_BE1.png/64px-Music_Disc_strad_JE1_BE1.png?8fa76 2x" data-file-width="160" data-file-height="160" /></a></span> <span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_ward_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_ward_JE1_BE1.png/32px-Music_Disc_ward_JE1_BE1.png?91cb9" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_ward_JE1_BE1.png/64px-Music_Disc_ward_JE1_BE1.png?91cb9 2x" data-file-width="160" data-file-height="160" /></a></span> 9 нових платівок були додані в гру, загалом стало 11 платівок, хоча вони не так часто <a href="/w/%D0%94%D1%80%D0%BE%D0%BF" title="Дроп">випадають</a> з <a href="/w/%D0%9A%D1%80%D1%96%D0%BF%D0%B5%D1%80" title="Кріпер">кріпера</a>. Вони зберігаються разом із першими платівками, 13.mus і cat.mus, (які були розшифровані як 13.ogg і cat.ogg відповідно).  До цього оновлення було 10 невикористаних музичних файлів, тепер залишився лише один невикористаний, це пісня «where are we now» (укр. <i>«де ми зараз»</i>). «where are we now» не було додано до решти нових 9 платівок через проблеми з пробілами в назві.<sup id="cite&#95;ref-:1&#95;5-0" class="reference"><a href="#cite_note-:1-5"><span class="cite-bracket">&#91;</span>4<span class="cite-bracket">&#93;</span></a></sup><sup id="cite&#95;ref-:2&#95;6-0" class="reference"><a href="#cite_note-:2-6"><span class="cite-bracket">&#91;</span>5<span class="cite-bracket">&#93;</span></a></sup></td></tr><tr><th class="nowrap" rowspan="1" colspan="3"><a href="/w/1.0.0_(Java_Edition)" title="1.0.0 (Java Edition)">1.0.0</a></th><th colspan="4" rowspan="1"><a href="/w/Beta_1.9_Prerelease_3_(Java_Edition)" title="Beta 1.9 Prerelease 3 (Java Edition)">Beta 1.9 Prerelease 3</a></th><td><a href="/w/%D0%A0%D1%96%D0%B4%D0%BA%D1%96%D1%81%D0%BD%D1%96%D1%81%D1%82%D1%8C" title="Рідкісність">Рідкісність</a> усіх платівок змінено на «Рідкісну», тепер замість білого відображається підказка з аквамариновим кольором.</td></tr><tr><th class="nowrap" rowspan="2" colspan="3"><a href="/w/1.1_(Java_Edition)" title="1.1 (Java Edition)">1.1</a></th><th colspan="4" rowspan="2"><a href="/w/11w50a_(Java_Edition)" title="11w50a (Java Edition)">11w50a</a></th><td>Усі платівки, окрім «11», тепер можна отримати з <a href="/w/%D0%9A%D1%80%D1%96%D0%BF%D0%B5%D1%80" title="Кріпер">кріпера</a>, убитого  <a href="/w/%D0%A1%D0%BA%D0%B5%D0%BB%D0%B5%D1%82" title="Скелет">скелетами</a>.
</td></tr><tr><td>Тепер усі платівки мають однакову ймовірність <a href="/w/%D0%94%D1%80%D0%BE%D0%BF" title="Дроп">випадіння</a>.</td></tr><tr><th class="nowrap" rowspan="2" colspan="3"><a href="/w/1.4.4_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="1.4.4 (Java Edition) (такої сторінки не існує)">1.4.4</a></th><th colspan="4" rowspan="2"><a href="/w/1.4.3_(Java_Edition)" title="1.4.3 (Java Edition)">1.4.3</a></th><td><span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_wait_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_wait_JE1_BE1.png/32px-Music_Disc_wait_JE1_BE1.png?f5bea" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_wait_JE1_BE1.png/64px-Music_Disc_wait_JE1_BE1.png?f5bea 2x" data-file-width="160" data-file-height="160" /></a></span> Платівка «where are we now» була перейменована на «wait» і стала доступна в грі.<sup id="cite&#95;ref-:1&#95;5-1" class="reference"><a href="#cite_note-:1-5"><span class="cite-bracket">&#91;</span>4<span class="cite-bracket">&#93;</span></a></sup><sup id="cite&#95;ref-:2&#95;6-1" class="reference"><a href="#cite_note-:2-6"><span class="cite-bracket">&#91;</span>5<span class="cite-bracket">&#93;</span></a></sup>
</td></tr><tr><td>Тепер платівка «11» доступна у режимі «Виживання». Їі скидають <a href="/w/%D0%9A%D1%80%D1%96%D0%BF%D0%B5%D1%80" title="Кріпер">кріпери</a> так само, як і інші платівки.</td></tr><tr><th class="nowrap" rowspan="1" colspan="3"><a href="/w/1.5_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="1.5 (Java Edition) (такої сторінки не існує)">1.5</a></th><th colspan="4" rowspan="1"><a href="/w/13w04a_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="13w04a (Java Edition) (такої сторінки не існує)">13w04a</a></th><td>Тепер активні <a href="/w/%D0%9F%D1%80%D0%BE%D0%B3%D1%80%D0%B0%D0%B2%D0%B0%D1%87" title="Програвач">програвачі</a> видають редстоуновий сигнал, коли <a href="/w/%D0%A0%D0%B5%D0%B4%D1%81%D1%82%D0%BE%D1%83%D0%BD%D0%BE%D0%B2%D0%B8%D0%B9_%D0%BA%D0%BE%D0%BC%D0%BF%D0%B0%D1%80%D0%B0%D1%82%D0%BE%D1%80" title="Редстоуновий компаратор">редстоуновий компаратор</a> розміщується за ним; його рівень сигналу залежить від ID вставленої платівки.</td></tr><tr><th class="nowrap" rowspan="3" colspan="3"><a href="/w/1.6.1_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="1.6.1 (Java Edition) (такої сторінки не існує)">1.6.1</a></th><th colspan="4" rowspan="3"><a href="/w/13w24a_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="13w24a (Java Edition) (такої сторінки не існує)">13 червня 2013 року</a></th><td>Тепер файли платівок можна змінювати за допомогою <a href="/w/%D0%9F%D0%B0%D0%BA%D0%B5%D1%82_%D1%82%D0%B5%D0%BA%D1%81%D1%82%D1%83%D1%80" title="Пакет текстур">пакету текстур</a>.
</td></tr><tr><td>До цієї версії, «cat» і «13» були єдиними платівками у форматі .ogg, всі інші платівки були у форматі .mus, який <i>Minecraft</i> розшифровував на льоту.
</td></tr><tr><td>Тепер файли платівок зберігаються в <code>assets/records</code>.</td></tr><tr><th class="nowrap" rowspan="1" colspan="3"><a href="/w/1.7.2_(Java_Edition)" title="1.7.2 (Java Edition)">1.7.2</a></th><th colspan="4" rowspan="1"><a href="/w/13w42a_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="13w42a (Java Edition) (такої сторінки не існує)">17 жовтня 2013 року</a></th><td>Тепер файли платівок зберігаються в <code>assets/sounds/records</code>.</td></tr><tr><th class="nowrap" rowspan="1" colspan="3"><a href="/w/1.7.4_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="1.7.4 (Java Edition) (такої сторінки не існує)">1.7.4</a></th><th colspan="4" rowspan="1"><a href="/w/13w49a_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="13w49a (Java Edition) (такої сторінки не існує)">5 грудня 2013 року</a></th><td>Тепер файли платівок зберігаються в індексованому хеші, а не безпосередньо в теці <code>.minecraft</code>.</td></tr><tr><th class="nowrap" rowspan="1" colspan="3"><a href="/w/1.9_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="1.9 (Java Edition) (такої сторінки не існує)">1.9</a></th><th colspan="4" rowspan="1"><a href="/w/15w44a_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="15w44a (Java Edition) (такої сторінки не існує)">15w44a</a></th><td>Середній показник платівок від скринь <a href="/w/%D0%A1%D0%BA%D0%B0%D1%80%D0%B1%D0%BD%D0%B8%D1%86%D1%8F" title="Скарбниця">скарбниць</a> було зменшено.</td></tr><tr><th class="nowrap" rowspan="1" colspan="3"><a href="/w/1.11_(Java_Edition)" title="1.11 (Java Edition)">1.11</a></th><th colspan="4" rowspan="1"><a href="/w/16w39a_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="16w39a (Java Edition) (такої сторінки не існує)">16w39a</a></th><td>Тепер платівки «cat» і «13» знаходяться в скрині нової структури під назвою <a href="/w/%D0%9B%D1%96%D1%81%D0%BE%D0%B2%D0%B8%D0%B9_%D0%BC%D0%B0%D1%94%D1%82%D0%BE%D0%BA" title="Лісовий маєток">лісовий маєток</a>.</td></tr><tr><th class="nowrap" rowspan="2" colspan="3"><a href="/w/1.13_(Java_Edition)" title="1.13 (Java Edition)">1.13</a></th><th colspan="4" rowspan="2"><a href="/w/17w47a_(Java_Edition)" title="17w47a (Java Edition)">17w47a</a></th><td>ID платівок змінено з <code>record_&lt;song&gt;</code> на <code>music_disc_&lt;song&gt;</code>.
</td></tr><tr><td>До <a href="/w/Java_Edition_1.13/Flattening?action=edit&amp;redlink=1" class="new" title="Java Edition 1.13/Flattening (такої сторінки не існує)"><i>The Flattening</i></a>, ID цих <a href="/w/%D0%9F%D1%80%D0%B5%D0%B4%D0%BC%D0%B5%D1%82" title="Предмет">предметів</a> були від 2256 до 2267.</td></tr><tr><th class="nowrap" rowspan="2" colspan="3"><a href="/w/1.14_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="1.14 (Java Edition) (такої сторінки не існує)">1.14</a></th><th colspan="4" rowspan="2"><a href="/w/18w43a_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="18w43a (Java Edition) (такої сторінки не існує)">18w43a</a></th><td><span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_11_JE2_BE2.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_11_JE2_BE2.png/32px-Music_Disc_11_JE2_BE2.png?daaef" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_11_JE2_BE2.png/64px-Music_Disc_11_JE2_BE2.png?daaef 2x" data-file-width="160" data-file-height="160" /></a></span> Текстуру платівки «11» було змінено.
</td></tr><tr><td>Тепер платівка також <a href="/w/%D0%94%D1%80%D0%BE%D0%BF" title="Дроп">скидаються</a> якщо <a href="/w/%D0%9A%D1%80%D1%96%D0%BF%D0%B5%D1%80" title="Кріпер">кріпера</a> застрелила <a href="/w/%D0%9F%D1%80%D0%B8%D0%BC%D0%B0%D1%80%D0%B0" title="Примара">примара</a>.</td></tr><tr><th class="nowrap" rowspan="1" colspan="3"><a href="/w/1.16_(Java_Edition)" title="1.16 (Java Edition)">1.16</a></th><th colspan="4" rowspan="1"><a href="/w/20w16a_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="20w16a (Java Edition) (такої сторінки не існує)">20w16a</a></th><td><span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_Pigstep_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_Pigstep_JE1_BE1.png/32px-Music_Disc_Pigstep_JE1_BE1.png?b760c" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_Pigstep_JE1_BE1.png/64px-Music_Disc_Pigstep_JE1_BE1.png?b760c 2x" data-file-width="160" data-file-height="160" /></a></span> Додано нову платівку під назвою «Pigstep».</td></tr><tr><th class="nowrap" rowspan="1" colspan="3"><a href="/w/1.16.2_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="1.16.2 (Java Edition) (такої сторінки не існує)">1.16.2</a></th><th colspan="4" rowspan="1"><a href="/w/20w30a_(Java_Edition)" title="20w30a (Java Edition)">20w30a</a></th><td>Шанс знайти «Pigstep» платівку в скринях <a href="/w/%D0%97%D0%B0%D0%BB%D0%B8%D1%88%D0%BA%D0%B8_%D0%B1%D0%B0%D1%81%D1%82%D1%96%D0%BE%D0%BD%D1%83" title="Залишки бастіону">залишків бастіону</a> було збільшено з 3.3% до 5.6%.</td></tr><tr><th class="nowrap" rowspan="1" colspan="3"><a href="/w/1.18_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="1.18 (Java Edition) (такої сторінки не існує)">1.18</a></th><th colspan="4" rowspan="1"><a href="/w/21w42a_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="21w42a (Java Edition) (такої сторінки не існує)">21w42a</a></th><td><span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_otherside_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_otherside_JE1_BE1.png/32px-Music_Disc_otherside_JE1_BE1.png?980f0" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_otherside_JE1_BE1.png/64px-Music_Disc_otherside_JE1_BE1.png?980f0 2x" data-file-width="160" data-file-height="160" /></a></span> Додано нову платівку під назвою «otherside».</td></tr><tr><th class="nowrap" rowspan="2" colspan="3"><a href="/w/1.19_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="1.19 (Java Edition) (такої сторінки не існує)">1.19</a></th><th colspan="4" rowspan="1"><a href="/w/22w13a_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="22w13a (Java Edition) (такої сторінки не існує)">22w13a</a></th><td>Платівки «13», «cat» і «otherside» можна знайти в <a href="/w/%D0%A1%D0%BA%D1%80%D0%B8%D0%BD%D1%8F" title="Скриня">скринях</a> <a href="/w/%D0%A1%D1%82%D0%B0%D1%80%D0%BE%D0%B4%D0%B0%D0%B2%D0%BD%D1%94_%D0%BC%D1%96%D1%81%D1%82%D0%BE" title="Стародавнє місто">стародавнього міста</a>.</td></tr><tr><th colspan="4" rowspan="1"><a href="/w/22w16a_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="22w16a (Java Edition) (такої сторінки не існує)">22w16a</a></th><td><span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_5_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_5_JE1_BE1.png/32px-Music_Disc_5_JE1_BE1.png?e7088" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_5_JE1_BE1.png/64px-Music_Disc_5_JE1_BE1.png?e7088 2x" data-file-width="160" data-file-height="160" /></a></span> Додано нову платівку під назвою «5».</td></tr><tr><th class="nowrap" rowspan="1" colspan="3"><a href="/w/1.19.1_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="1.19.1 (Java Edition) (такої сторінки не існує)">1.19.1</a></th><th colspan="4" rowspan="1"><a href="/w/22w24a_(Java_Edition)?action=edit&amp;redlink=1" class="new" title="22w24a (Java Edition) (такої сторінки не існує)">22w24a</a></th><td>Тепер платівка необхідна для дублювання <a href="/w/%D0%97%D0%B1%D0%B8%D1%80%D0%B8%D0%BA" title="Збирик">збириків</a>.</td></tr><tr><th class="nowrap" rowspan="1" colspan="3"><a href="/w/1.20_(Java_Edition)" title="1.20 (Java Edition)">1.20</a></th><th colspan="4" rowspan="1"><a href="/w/23w17a_(Java_Edition)" title="23w17a (Java Edition)">23w17a</a></th><td><span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_Relic_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_Relic_JE1_BE1.png/32px-Music_Disc_Relic_JE1_BE1.png?fed2e" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_Relic_JE1_BE1.png/64px-Music_Disc_Relic_JE1_BE1.png?fed2e 2x" data-file-width="160" data-file-height="160" /></a></span> Додано нову платівку під назвою «Relic».</td></tr><tr><th class="nowrap" rowspan="1" colspan="3"><a href="/w/1.20.5_(Java_Edition)" title="1.20.5 (Java Edition)">1.20.5</a><div class="historytable-experiment"><div>Експеримент</div></div><span>Оновлення 1.21</span></th><th colspan="4" rowspan="1"><a href="/w/24w07a_(Java_Edition)" title="24w07a (Java Edition)">24w07a</a></th><td>Тепер платівка також <a href="/w/%D0%94%D1%80%D0%BE%D0%BF" title="Дроп">скидаютьсяіз</a> <a href="/w/%D0%9A%D1%80%D1%96%D0%BF%D0%B5%D1%80" title="Кріпер">кріпера</a> вбитого <a href="/w/%D0%91%D0%BE%D0%BB%D0%BE%D1%82%D1%8F%D0%BD%D0%B8%D0%BA" title="Болотяник">болотяником</a>.</td></tr><tr><th class="nowrap" rowspan="3" colspan="3"><a href="/w/1.21_(Java_Edition)" title="1.21 (Java Edition)">1.21</a></th><th colspan="4" rowspan="1"><a href="/w/24w18a_(Java_Edition)" title="24w18a (Java Edition)">24w18a</a></th><td><span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_Creator_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_Creator_JE1_BE1.png/32px-Music_Disc_Creator_JE1_BE1.png?c775d" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_Creator_JE1_BE1.png/64px-Music_Disc_Creator_JE1_BE1.png?c775d 2x" data-file-width="160" data-file-height="160" /></a></span> <span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_Creator_(Music_Box)_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_Creator_%28Music_Box%29_JE1_BE1.png/32px-Music_Disc_Creator_%28Music_Box%29_JE1_BE1.png?f9fd9" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_Creator_%28Music_Box%29_JE1_BE1.png/64px-Music_Disc_Creator_%28Music_Box%29_JE1_BE1.png?f9fd9 2x" data-file-width="160" data-file-height="160" /></a></span> <span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_Precipice_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_Precipice_JE1_BE1.png/32px-Music_Disc_Precipice_JE1_BE1.png?57f6c" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_Precipice_JE1_BE1.png/64px-Music_Disc_Precipice_JE1_BE1.png?57f6c 2x" data-file-width="160" data-file-height="160" /></a></span> Додано три нові платівки з назвами «Creator», «Creator (музична скринька)» і «Precipice».</td></tr><tr><th colspan="4" rowspan="2"><a href="/w/24w21a_(Java_Edition)" title="24w21a (Java Edition)">24w21a</a></th><td>З додаванням <a href="/w/%D0%92%D0%B8%D0%B7%D0%BD%D0%B0%D1%87%D0%B5%D0%BD%D0%BD%D1%8F_%D0%BF%D1%96%D1%81%D0%BD%D1%96_%D0%BF%D1%80%D0%BE%D0%B3%D1%80%D0%B0%D0%B2%D0%B0%D1%87%D0%B0" title="Визначення пісні програвача">визначення пісні програвача</a> тепер можна створювати спеціальні платівки за допомогою пакетів даних.</td></tr><tr><td>Тепер усі платівки мають пов’язане визначення пісні .json програвача <code>data/minecraft/jukebox_song</code></td></tr><tr><th class="nowrap" rowspan="1" colspan="3"><a href="/w/1.21.2_(Java_Edition)" title="1.21.2 (Java Edition)">1.21.2</a></th><th colspan="4" rowspan="1"><a href="/w/24w33a_(Java_Edition)" title="24w33a (Java Edition)">24w33a</a></th><td>Рідкісність платівок, за винятком «Pigstep», «otherside» та «Creator», було змінено з «Рідкісної» на «Незвичайну».</td></tr><tr><th class="nowrap" rowspan="1" colspan="3"><a href="/w/1.21.6_(Java_Edition)" title="1.21.6 (Java Edition)">1.21.6</a></th><th colspan="4" rowspan="1"><a href="/w/25w20a_(Java_Edition)" title="25w20a (Java Edition)">25w20a</a></th><td><span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_Tears_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_Tears_JE1_BE1.png/32px-Music_Disc_Tears_JE1_BE1.png?ff16b" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_Tears_JE1_BE1.png/64px-Music_Disc_Tears_JE1_BE1.png?ff16b 2x" data-file-width="160" data-file-height="160" /></a></span> Додано нову платівку під назвою «Tears».</td></tr><tr><th class="nowrap" rowspan="1" colspan="3"><a href="/w/1.21.7_(Java_Edition)" title="1.21.7 (Java Edition)">1.21.7</a></th><th colspan="4" rowspan="1"><a href="/w/1.21.7_Release_Candidate_1_(Java_Edition)" title="1.21.7 Release Candidate 1 (Java Edition)">Release Candidate 1</a></th><td><span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_Lava_Chicken_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_Lava_Chicken_JE1_BE1.png/32px-Music_Disc_Lava_Chicken_JE1_BE1.png?d74bb" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_Lava_Chicken_JE1_BE1.png/64px-Music_Disc_Lava_Chicken_JE1_BE1.png?d74bb 2x" data-file-width="160" data-file-height="160" /></a></span> Додано нову платівку під назвою «Lava Chicken».</td></tr><tr class="collapsible collapsible-rows"><th class="historytable-subheader" colspan="8" style="border-bottom: none"><a href="/w/%D0%86%D1%81%D1%82%D0%BE%D1%80%D1%96%D1%8F_%D0%B2%D0%B5%D1%80%D1%81%D1%96%D0%B9_(Bedrock_Edition)" title="Історія версій (Bedrock Edition)"><i>Bedrock Edition</i></a></th></tr><tr><th class="nowrap" rowspan="1" colspan="3"><a href="/w/1.2.0_(Bedrock_Edition)?action=edit&amp;redlink=1" class="new" title="1.2.0 (Bedrock Edition) (такої сторінки не існує)">1.2.0</a></th><th colspan="4" rowspan="1"><a href="/w/Beta_1.2.0.2_(Bedrock_Edition)?action=edit&amp;redlink=1" class="new" title="Beta 1.2.0.2 (Bedrock Edition) (такої сторінки не існує)">beta 1.2.0.2</a></th><td><span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_11_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_11_JE1_BE1.png/32px-Music_Disc_11_JE1_BE1.png?b1d4c" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_11_JE1_BE1.png/64px-Music_Disc_11_JE1_BE1.png?b1d4c 2x" data-file-width="160" data-file-height="160" /></a></span> <span typeof="mw:File"><a href="/w/%D0%A4%D0%B0%D0%B9%D0%BB:Music_Disc_13_JE1_BE1.png" class="mw-file-description"><img src="https://minecraft.wiki/images/thumb/Music_Disc_13_JE1_BE1.png/32px-Music_Disc_13_JE1_BE1.png?3ad74" decoding="async" loading="lazy" width="32" height="32" class="mw-file-element" srcset="https://minecraft.wiki/images/thumb/Music_Disc_13_JE1_BE1.png/64px-Music_Disc_13_JE1_BE1.png?3ad74 2x" data-file-width="160" data-file-height="160" /></a></span> <span typeof="mw:File"><